{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "zeroui",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "minify": true,
  // The public site and the registry (/r/*.json) both live here; the registry URL in
  // src/lib/site.ts and the docs must match the first domain. The second is the name the library
  // had until 2026-10-26: its pages redirect to the first (next.config.ts), and its registry files
  // are still served, so projects set up with it keep working.
  "routes": [
    {
      "pattern": "zzzui.catforest.dev",
      "custom_domain": true
    },
    {
      "pattern": "zeroui.catforest.dev",
      "custom_domain": true
    }
  ]
}
